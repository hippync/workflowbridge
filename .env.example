# Application
ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=workflowbridge;Username=workflowbridge;Password=workflowbridge

# AI provider selection
AI__Provider=Mock

# Anthropic provider
ANTHROPIC_API_KEY=
AI__Anthropic__Model=claude-sonnet-4-5

# Recorded provider
AI__Recorded__CassettePath=./recordings

# Local development identity
AUTH__Mode=Local
AUTH__LocalUserName=credit.analyst@workflowbridge.local
AUTH__LocalRole=CreditAnalyst
