# Stripe — get from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Notion — get from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_key_here
NOTION_DATABASE_ID=your_database_id_here

# Slack — get from https://api.slack.com/apps (Incoming Webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Vercel KV — auto-populated when you link the KV instance to your project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# App config
NODE_ENV=development
